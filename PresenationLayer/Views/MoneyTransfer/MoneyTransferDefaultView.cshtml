@model DCAssignment2.Models.User

@{
    ViewData["Title"] = "Money Transfer";

    var mode = (ViewBag.Mode as string) ?? "own";
    var selectedFromId = ViewBag.SelectedFromId as int? ?? Model.Accounts.FirstOrDefault()?.Id ?? 0;
    var otherAccounts = ViewBag.OtherAccounts as List<DCAssignment2.Models.Account> ?? new List<DCAssignment2.Models.Account>();
}

<div class="container mt-4">
    <h2>💸 Money Transfer</h2>

    @if (!string.IsNullOrWhiteSpace(ViewBag.SuccessMessage as string))
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @ViewBag.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage as string))
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> @ViewBag.ErrorMessage
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Transfer Funds</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="Transfer" asp-controller="MoneyTransfer" id="transferForm">
                @Html.AntiForgeryToken()

                <!-- Transfer Mode Selection -->
                <div class="row mb-4">
                    <div class="col-12">
                        <label class="form-label fw-bold">Transfer Type:</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="Mode" id="modeOwn" value="own" @(mode == "own" ? "checked" : "")>
                            <label class="btn btn-outline-primary" for="modeOwn">
                                <i class="fas fa-user"></i> My Accounts
                            </label>

                            <input type="radio" class="btn-check" name="Mode" id="modeOther" value="other" @(mode == "other" ? "checked" : "")>
                            <label class="btn btn-outline-primary" for="modeOther">
                                <i class="fas fa-users"></i> Other User
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Source Account -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="FromAccountId" class="form-label fw-bold">From Account:</label>
                        <select id="FromAccountId" name="FromAccountId" class="form-select" required>
                            <option value="">-- Select Source Account --</option>
                            @foreach (var acc in Model.Accounts)
                            {
                                if (acc.Id == selectedFromId)
                                {
                                    <option value="@acc.Id" data-balance="@acc.Balance" selected>
                                        @acc.AccountNumber - @acc.AccountType (Balance: @acc.Balance.ToString("C"))
                                    </option>
                                }
                                else
                                {
                                    <option value="@acc.Id" data-balance="@acc.Balance">
                                        @acc.AccountNumber - @acc.AccountType (Balance: @acc.Balance.ToString("C"))
                                    </option>
                                }
                            }
                        </select>
                        <small class="form-text text-muted" id="balanceDisplay"></small>
                    </div>
                </div>

                <!-- Recipient Selection -->
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold">Recipient:</label>

                        <!-- Own Accounts (shown when mode is "own") -->
                        <div id="ownRecipientSection" class="recipient-section" style="@(mode == "own" ? "display:block;" : "display:none;")">
                            <select id="RecipientAccountId" name="RecipientAccountId" class="form-select">
                                <option value="">-- Select Your Account --</option>
                                @foreach (var acc in Model.Accounts)
                                {
                                    <option value="@acc.Id">
                                        @acc.AccountNumber - @acc.AccountType
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Other Accounts (shown when mode is "other") -->
                        <div id="otherRecipientSection" class="recipient-section" style="@(mode == "other" ? "display:block;" : "display:none;")">
                            @if (otherAccounts.Any())
                            {
                                <div class="mb-2">
                                    <label class="form-label">Select from other users:</label>
                                    <select id="RecipientAccountIdOther" name="RecipientAccountId" class="form-select">
                                        <option value="">-- Select Recipient Account --</option>
                                        @foreach (var racc in otherAccounts)
                                        {
                                            <option value="@racc.Id" data-account-number="@racc.AccountNumber">
                                                @racc.AccountNumber - @racc.AccountType (User: @racc.User.Username)
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <div>
                                <label class="form-label">Or enter account number:</label>
                                <input type="text" id="RecipientAccountNumber" name="RecipientAccountNumber"
                                       class="form-control" placeholder="Enter recipient account number"
                                       value="@(ViewBag.RecipientAccountNumber ?? "")" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Amount and Description -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="Amount" class="form-label fw-bold">Amount ($):</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" min="0.01" id="Amount" name="Amount"
                                   class="form-control" placeholder="0.00"
                                   value="@(ViewBag.Amount ?? "")" required />
                        </div>
                        <small class="form-text text-muted">Minimum amount: $0.01</small>
                    </div>

                    <div class="col-md-6">
                        <label for="Description" class="form-label fw-bold">Description:</label>
                        <input type="text" id="Description" name="Description"
                               class="form-control" placeholder="Optional transfer description"
                               value="@(ViewBag.Description ?? "")" />
                    </div>
                </div>

                <!-- Transfer Summary -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Transfer Summary</h6>
                                <div id="transferSummary" class="text-muted">
                                    Select accounts and amount to see transfer details...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row">
                    <div class="col-12">
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="reset" class="btn btn-secondary me-md-2">
                                <i class="fas fa-redo"></i> Reset
                            </button>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-paper-plane"></i> Transfer Money
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Tips -->
    <div class="mt-4">
        <div class="alert alert-info">
            <h6><i class="fas fa-info-circle"></i> Transfer Guidelines</h6>
            <ul class="mb-0">
                <li>Transfers between your own accounts are processed instantly</li>
                <li>Transfers to other users may take 1-2 business days</li>
                <li>Minimum transfer amount: $0.01</li>
                <li>Ensure sufficient funds in source account</li>
                <li>Double-check recipient account numbers for external transfers</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mode switching
        document.querySelectorAll('input[name="Mode"]').forEach(radio => {
            radio.addEventListener('change', function() {
                document.querySelectorAll('.recipient-section').forEach(section => {
                    section.style.display = 'none';
                });

                if (this.value === 'own') {
                    document.getElementById('ownRecipientSection').style.display = 'block';
                } else {
                    document.getElementById('otherRecipientSection').style.display = 'block';
                }
                updateTransferSummary();
            });
        });

        // Balance display
        document.getElementById('FromAccountId').addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const balance = selectedOption.getAttribute('data-balance');
            document.getElementById('balanceDisplay').textContent = `Available balance: $${parseFloat(balance).toFixed(2)}`;
            updateTransferSummary();
        });

        // Transfer summary update
        function updateTransferSummary() {
            const fromSelect = document.getElementById('FromAccountId');
            const fromAccount = fromSelect.options[fromSelect.selectedIndex]?.text || 'Not selected';

            const mode = document.querySelector('input[name="Mode"]:checked')?.value;
            let toAccount = 'Not selected';

            if (mode === 'own') {
                const toSelect = document.getElementById('RecipientAccountId');
                toAccount = toSelect.options[toSelect.selectedIndex]?.text || 'Not selected';
            } else {
                const toSelect = document.getElementById('RecipientAccountIdOther');
                const accountNumber = document.getElementById('RecipientAccountNumber').value;
                toAccount = toSelect.options[toSelect.selectedIndex]?.text ||
                           (accountNumber ? `Account: ${accountNumber}` : 'Not selected');
            }

            const amount = document.getElementById('Amount').value;
            const amountText = amount ? `$${parseFloat(amount).toFixed(2)}` : 'Not specified';

            document.getElementById('transferSummary').innerHTML = `
                <strong>From:</strong> ${fromAccount}<br>
                <strong>To:</strong> ${toAccount}<br>
                <strong>Amount:</strong> ${amountText}
            `;
        }

        // Update summary on any change
        document.querySelectorAll('#FromAccountId, #RecipientAccountId, #RecipientAccountIdOther, #RecipientAccountNumber, #Amount')
            .forEach(element => {
                element.addEventListener('change', updateTransferSummary);
                element.addEventListener('input', updateTransferSummary);
            });

        // Form validation
        document.getElementById('transferForm').addEventListener('submit', function(e) {
            const amount = parseFloat(document.getElementById('Amount').value);
            const fromBalance = parseFloat(document.getElementById('FromAccountId').options[document.getElementById('FromAccountId').selectedIndex]?.getAttribute('data-balance') || 0);

            if (amount > fromBalance) {
                e.preventDefault();
                alert('Insufficient funds! Please enter an amount within your available balance.');
                return false;
            }

            if (amount <= 0) {
                e.preventDefault();
                alert('Please enter a valid amount greater than $0.00.');
                return false;
            }
        });

        // Initialize balance display and summary
        document.addEventListener('DOMContentLoaded', function() {
            const fromSelect = document.getElementById('FromAccountId');
            if (fromSelect.selectedIndex >= 0) {
                fromSelect.dispatchEvent(new Event('change'));
            }
            updateTransferSummary();
        });
    </script>

    <style>
        .recipient-section {
            transition: all 0.3s ease;
        }

        .btn-check:checked + .btn-outline-primary {
            background-color: #0d6efd;
            color: white;
        }

        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
    </style>
}