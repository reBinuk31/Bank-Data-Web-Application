@model DCAssignment2.Models.User

@{
    ViewData["Title"] = "Transfer Successful";
    var trxInfo = ViewBag.TransferInfo; 
}

<div class="container mt-4">
    <h2>Transfer Successful</h2>
    <div class="alert alert-success">
        <strong>Success:</strong> @(ViewBag.SuccessMessage ?? "Money transferred successfully.")
    </div>

    @if (trxInfo != null)
    {
        <div class="card p-3">
            <p><strong>From:</strong> @(ViewBag.FromAccountNumber ?? "")</p>
            <p><strong>To:</strong> @(ViewBag.RecipientAccountNumber ?? "")</p>
            <p><strong>Amount:</strong> @(ViewBag.Amount ?? "")</p>
            <p><strong>Description:</strong> @(ViewBag.Description ?? "")</p>
            <p><strong>Timestamp:</strong> @(ViewBag.Timestamp ?? DateTime.Now)</p>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" asp-controller="Dashboard" class="btn btn-primary">Back to Dashboard</a>
        <a asp-action="Default" asp-controller="Money" class="btn btn-secondary">Make another transfer</a>
    </div>
</div>
