@{
    ViewData["Title"] = "Welcome to the Bank Web Application";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h1 class="mb-4">Welcome to the Bank Web Application</h1>
            <p class="text-muted mb-4">Please log in to access your dashboard</p>

            <form asp-controller="Login" asp-action="Authenticate" method="post" class="card p-4 shadow-sm">
                <div class="form-group mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" name="username" class="form-control" placeholder="Enter username" required />
                </div>

                <div class="form-group mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Enter password" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>


            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Error</div>
            }
        </div>
    </div>
</div>
