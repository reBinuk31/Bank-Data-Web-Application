@{
    ViewData["Title"] = "Security & Audit Logs";
}

<div class="container mt-4">
    <h2>Security & Audit Logs</h2>
    <p class="text-muted">Track admin activities and system changes.</p>

    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Date/Time</th>
                <th>Admin</th>
                <th>Action</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Timestamp</td>
                    <td>@log.AdminName</td>
                    <td>@log.Action</td>
                    <td>@log.Details</td>
                </tr>
            }
        </tbody>
    </table>
</div>
