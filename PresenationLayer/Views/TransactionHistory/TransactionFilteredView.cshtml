@model DCAssignment2.Models.User

@{
    ViewData["Title"] = "Filtered Transactions";

    // IDs of all accounts belonging to the current user
    var userAccountIds = Model.Accounts.Select(a => a.Id).ToList();

    // Combine all transactions (sent + received) from all user's accounts
    var allTransactions = Model.Accounts
        .SelectMany(a => a.SentTransactions.Concat(a.ReceivedTransactions))
        .OrderByDescending(t => t.Timestamp)
        .ToList();
}

<div class="container mt-4">
    <h2>📄 Filtered Transaction History</h2>
    <hr />

    <!-- 🔍 Search Form -->
    <form method="get" asp-action="TransactionFilteredView" asp-controller="TransactionHistory" class="mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <input type="text" name="searchUsername" class="form-control" placeholder="Search by username" value="@ViewBag.SearchUsername" />
            </div>
            <div class="col-md-3">
                <input type="text" name="searchAccount" class="form-control" placeholder="Search by account number" value="@ViewBag.SearchAccount" />
            </div>
            <div class="col-md-3">
                <input type="text" name="searchDescription" class="form-control" placeholder="Search by description" value="@ViewBag.SearchDescription" />
            </div>
            <div class="col-md-3 d-flex">
                <input type="date" name="fromDate" class="form-control me-2" value="@ViewBag.FromDateStr" />
                <input type="date" name="toDate" class="form-control me-2" value="@ViewBag.ToDateStr" />
                <button type="submit" class="btn btn-primary">🔍 Search</button>
            </div>
        </div>
    </form>

    @if (!allTransactions.Any())
    {
        <div class="alert alert-warning">
            No transactions found for the selected criteria.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Txn ID</th>
                    <th>
                        Date
                        <a asp-action="TransactionFilteredView" asp-route-sortBy="Date" asp-route-order="asc">▲</a>
                        <a asp-action="TransactionFilteredView" asp-route-sortBy="Date" asp-route-order="desc">▼</a>
                    </th>
                    <th>From Account</th>
                    <th>To Account</th>
                    <th>Description</th>
                    <th>
                        Amount ($)
                        <a asp-action="TransactionFilteredView" asp-route-sortBy="Amount" asp-route-order="asc">▲</a>
                        <a asp-action="TransactionFilteredView" asp-route-sortBy="Amount" asp-route-order="desc">▼</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var txn in allTransactions)
                {
                    // Determine if transaction is outgoing from current user's perspective
                    var isOutgoing = userAccountIds.Contains(txn.FromAccountId);
                    var symbol = isOutgoing ? "-" : "+";

                    <tr class="@(isOutgoing ? "table-danger" : "table-success")">
                        <td>@txn.TransactionId</td>
                        <td>@txn.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@txn.FromAccount?.AccountNumber ?? "N/A"</td>
                        <td>@txn.ToAccount?.AccountNumber ?? "N/A"</td>
                        <td>@txn.Description</td>
                        <td>@symbol@txn.AmountTransferred.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

