@model DCAssignment2.Models.User

@{
    ViewData["Title"] = "Transaction History";

    // Use transactions from ViewBag instead of Model
    var userTransactions = ViewBag.UserTransactions as List<DCAssignment2.Models.Transaction> ?? new List<DCAssignment2.Models.Transaction>();
    var firstAccount = Model.Accounts.FirstOrDefault();
    var firstAccountId = firstAccount?.Id ?? 0;
    
    // Get filter parameters from ViewBag or default values
    var fromDateFilter = ViewBag.FromDateFilter as DateTime? ?? DateTime.Today.AddMonths(-1);
    var toDateFilter = ViewBag.ToDateFilter as DateTime? ?? DateTime.Today;
    var sortOrder = ViewBag.SortOrder as string ?? "newest";
    
    // Apply date filtering
    var filteredTransactions = userTransactions
        .Where(t => t.Timestamp.Date >= fromDateFilter.Date && t.Timestamp.Date <= toDateFilter.Date)
        .ToList();
    
    // Apply sorting
    switch (sortOrder)
    {
        case "oldest":
            filteredTransactions = filteredTransactions.OrderBy(t => t.Timestamp).ToList();
            break;
        case "amount_asc":
            filteredTransactions = filteredTransactions.OrderBy(t => t.AmountTransferred).ToList();
            break;
        case "amount_desc":
            filteredTransactions = filteredTransactions.OrderByDescending(t => t.AmountTransferred).ToList();
            break;
        case "newest":
        default:
            filteredTransactions = filteredTransactions.OrderByDescending(t => t.Timestamp).ToList();
            break;
    }
}

<div class="container mt-4">
    <h2>Transaction History</h2>

    <!-- Filter and Sort Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Filter & Sort Transactions</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-action="FilterTransactions" asp-controller="TransactionHistory" class="row g-3">
                <!-- Account Selection -->
                <div class="col-md-3">
                    <label for="accountSelect" class="form-label">Select Account:</label>
                    <select id="accountSelect" name="accountId" class="form-select">
                        @foreach (var acc in Model.Accounts)
                        {
                            <option value="@acc.Id" selected="@(acc.Id == firstAccountId ? "selected" : null)">
                                @acc.AccountNumber (@acc.AccountType) - $@acc.Balance.ToString("F2")
                            </option>
                        }
                    </select>
                </div>

                <!-- Date Range Filter -->
                <div class="col-md-4">
                    <label class="form-label">Date Range:</label>
                    <div class="input-group">
                        <input type="date" id="fromDate" name="fromDate" class="form-control" 
                               value="@fromDateFilter.ToString("yyyy-MM-dd")" />
                        <span class="input-group-text">to</span>
                        <input type="date" id="toDate" name="toDate" class="form-control" 
                               value="@toDateFilter.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <!-- Sort Options -->
                <div class="col-md-3">
                    <label for="sortOrder" class="form-label">Sort By:</label>
                    <select id="sortOrder" name="sortOrder" class="form-select">
                        <option value="newest" selected="@(sortOrder == "newest")">Newest First</option>
                        <option value="oldest" selected="@(sortOrder == "oldest")">Oldest First</option>
                        <option value="amount_desc" selected="@(sortOrder == "amount_desc")">Amount (High to Low)</option>
                        <option value="amount_asc" selected="@(sortOrder == "amount_asc")">Amount (Low to High)</option>
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="col-md-2 d-flex align-items-end">
                    <div class="btn-group w-100">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-filter"></i> Apply
                        </button>
                        <a href="@Url.Action("TransactionDefaultView", "TransactionHistory")" class="btn btn-outline-secondary">
                            <i class="fas fa-refresh"></i> Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Transaction Summary -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="alert alert-info">
                <strong>Showing:</strong> 
                @filteredTransactions.Count transactions from 
                @fromDateFilter.ToString("MMM dd, yyyy") to @toDateFilter.ToString("MMM dd, yyyy")
                @if (filteredTransactions.Count > 0)
                {
                    <span> | </span>
                    <strong>Total: </strong>@filteredTransactions.Sum(t => t.AmountTransferred).ToString("C")
                }
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    @if (!filteredTransactions.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            No transactions found for the selected criteria.
            @if (userTransactions.Any() && (!filteredTransactions.Any()))
            {
                <br />
                <small>Try adjusting your date range or select a different account.</small>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Transaction Type</th>
                        <th>From / To Account</th>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in filteredTransactions)
                    {
                        var isSent = t.FromAccountId == firstAccountId;
                        var isTransfer = t.FromAccountId != t.ToAccountId;
                        <tr>
                            <td>
                                <strong>@t.Timestamp.ToString("MMM dd, yyyy")</strong>
                                <br />
                                <small class="text-muted">@t.Timestamp.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                @if (isTransfer)
                                {
                                    <span class="badge @(isSent ? "bg-warning" : "bg-success")">
                                        @(isSent ? "OUTGOING" : "INCOMING")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info">INTERNAL</span>
                                }
                            </td>
                            <td>
                                @if (isSent && isTransfer)
                                {
                                    <div>
                                        <strong>To:</strong> @t.ToAccount?.AccountNumber
                                    </div>
                                    <small class="text-muted">@t.ToAccount?.AccountType</small>
                                }
                                else if (!isSent && isTransfer)
                                {
                                    <div>
                                        <strong>From:</strong> @t.FromAccount?.AccountNumber
                                    </div>
                                    <small class="text-muted">@t.FromAccount?.AccountType</small>
                                }
                                else
                                {
                                    <div>
                                        <strong>@(t.Description.Contains("Deposit") ? "Deposit to" : "Withdrawal from")</strong>
                                        @t.FromAccount?.AccountNumber
                                    </div>
                                    <small class="text-muted">@t.FromAccount?.AccountType</small>
                                }
                            </td>
                            <td>@t.Description</td>
                            <td class="text-end">
                                <span class="fw-bold @(isSent && isTransfer ? "text-danger" : "text-success")">
                                    @(isSent && isTransfer ? "-" : "+")@Math.Abs(t.AmountTransferred).ToString("C")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
                @if (filteredTransactions.Count > 5)
                {
                    <tfoot class="table-secondary">
                        <tr>
                            <td colspan="4" class="text-end"><strong>Total:</strong></td>
                            <td class="text-end fw-bold">
                                @{
                                    var totalIncoming = filteredTransactions.Where(t => t.FromAccountId != firstAccountId).Sum(t => t.AmountTransferred);
                                    var totalOutgoing = filteredTransactions.Where(t => t.FromAccountId == firstAccountId && t.FromAccountId != t.ToAccountId).Sum(t => t.AmountTransferred);
                                    var netAmount = totalIncoming - totalOutgoing;
                                }
                                <span class="@(netAmount >= 0 ? "text-success" : "text-danger")">
                                    @netAmount.ToString("C")
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        <!-- Export Options -->
        <div class="mt-3">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="printTransactions()">
                    <i class="fas fa-print"></i> Print
                </button>
                <button type="button" class="btn btn-outline-success btn-sm" onclick="exportToCSV()">
                    <i class="fas fa-download"></i> Export CSV
                </button>
            </div>
        </div>
    }
</div>

<!-- JavaScript for enhanced functionality -->
@section Scripts {
    <script>
        // Auto-submit form when account selection changes
        document.getElementById('accountSelect').addEventListener('change', function() {
            this.form.submit();
        });

        // Validate date range
        document.querySelector('form').addEventListener('submit', function(e) {
            const fromDate = new Date(document.getElementById('fromDate').value);
            const toDate = new Date(document.getElementById('toDate').value);
            
            if (fromDate > toDate) {
                e.preventDefault();
                alert('End date cannot be before start date.');
                return false;
            }
            
            // Limit date range to 1 year for performance
            const oneYearAgo = new Date();
            oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
            
            if (fromDate < oneYearAgo) {
                e.preventDefault();
                alert('Please select a start date within the last year.');
                return false;
            }
        });

        // Print functionality
        function printTransactions() {
            window.print();
        }

        // Export to CSV functionality
        function exportToCSV() {
            const transactions = @Html.Raw(Json.Serialize(filteredTransactions.Select(t => new {
                Date = t.Timestamp.ToString("yyyy-MM-dd"),
                Time = t.Timestamp.ToString("HH:mm"),
                Type = t.FromAccountId == firstAccountId ? "Outgoing" : "Incoming",
                FromAccount = t.FromAccount?.AccountNumber,
                ToAccount = t.ToAccount?.AccountNumber,
                Description = t.Description,
                Amount = t.AmountTransferred
            })));
            
            let csv = 'Date,Time,Type,From Account,To Account,Description,Amount\n';
            
            transactions.forEach(t => {
                csv += `"${t.Date}","${t.Time}","${t.Type}","${t.FromAccount}","${t.ToAccount}","${t.Description}","${t.Amount}"\n`;
            });
            
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('hidden', '');
            a.setAttribute('href', url);
            a.setAttribute('download', 'transactions.csv');
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Set max date to today for date inputs
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('toDate').max = today;
            document.getElementById('fromDate').max = today;
        });
    </script>

    <style>
        @@media print {
            .card, .alert, .btn-group {
                display: none !important;
            }
            
            .table {
                font-size: 12px;
            }
            
            h2 {
                color: #000 !important;
            }
        }
        
        .badge {
            font-size: 0.7em;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.075);
        }
    </style>
}