@model List<DCAssignment2.Models.Account>

<div class="container mt-4">
    <h2>Account Summary</h2>

    @if(Model != null && Model.Count > 0)
    {
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Account Number</th>
                    <th>Account Type</th>
                    <th>Balance</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var account in Model)
                {
                    <tr>
                        <td>@account.AccountNumber</td>
                        <td>
                            @switch(account.AccountType.ToLower())
                            {
                                case "checking":
                                    @:Checking
                                    break;
                                case "saving":
                                    @:Saving
                                    break;
                                default:
                                    @:Other
                                    break;
                            }
                        </td>
                        <td>@account.Balance.ToString("C")</td>
                        <td>
                            @* <a asp-controller="Transactions" 
                               asp-action="Index" 
                               asp-route-accountNumber="@account.AccountNumber" 
                               class="btn btn-sm btn-primary">
                                View Transactions
                            </a> *@
                            <a asp-controller="TransactionHistory"
                               asp-action="TransactionDefaultView"
                               asp-route-accountId="@account.Id"
                               class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-history"></i> View Transactions
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No accounts found.</p>
    }
</div>
