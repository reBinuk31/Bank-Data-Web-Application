@model IEnumerable<DCAssignment2.Models.Transaction>

@{
    ViewData["Title"] = "Transaction Management";
}

<div class="container mt-4">
    <h2>📄 Transaction Management</h2>
    <hr />

    <!-- Search & Filter -->
    <form method="get" asp-action="TransactionFilteredView" class="mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <input type="text" name="searchUsername" class="form-control" placeholder="Search by username" />
            </div>
            <div class="col-md-3">
                <input type="text" name="searchAccount" class="form-control" placeholder="Search by account number" />
            </div>
            <div class="col-md-3">
                <input type="text" name="searchDescription" class="form-control" placeholder="Search by description" />
            </div>
            <div class="col-md-3 d-flex">
                <input type="date" name="fromDate" class="form-control me-2" />
                <input type="date" name="toDate" class="form-control me-2" />
                <button type="submit" class="btn btn-primary"> Search</button>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No transactions found for the selected period.
        </div>
    }

    @if (Model.Any())
    {
        <table class="table table-striped table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Txn ID</th>
                    <th>
                        Date
                        <a asp-action="TransactionDefaultView" asp-route-sortBy="Date" asp-route-order="asc">▲</a>
                        <a asp-action="TransactionDefaultView" asp-route-sortBy="Date" asp-route-order="desc">▼</a>
                    </th>
                    <th>From Account</th>
                    <th>To Account</th>
                    <th>Description</th>
                    <th>
                        Amount ($)
                        <a asp-action="TransactionDefaultView" asp-route-sortBy="Amount" asp-route-order="asc">▲</a>
                        <a asp-action="TransactionDefaultView" asp-route-sortBy="Amount" asp-route-order="desc">▼</a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var txn in Model)
                {
                    <tr>
                        <td>@txn.TransactionId</td>
                        <td>@txn.Timestamp.ToString("yyyy-MM-dd")</td>
                        <td>@txn.FromAccount?.AccountNumber (@txn.FromAccount?.User?.Username)</td>
                        <td>@txn.ToAccount?.AccountNumber (@txn.ToAccount?.User?.Username)</td>
                        <td>@txn.Description</td>
                        <td>
                            @(txn.AmountTransferred < 0 ? "-" : "+")
                            @Math.Abs(txn.AmountTransferred).ToString("C")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
